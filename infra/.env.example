# Docker Compose variables for local infrastructure services
# for the passwords you can use 

# PostgreSQL
POSTGRES_DB=secure_chess
POSTGRES_USER=secure_chess_user
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=choose_a_port

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=choose_a_port

# JWT
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
